#!/bin/sh
# gpg.ssh.program: ssh-keygen with no agent, so signing uses this machine's
# key file (~/.ssh/id_git, from `mise run git:key`) and never waits on an
# approval. Without this, `ssh-keygen -Y sign` asks whatever agent
# SSH_AUTH_SOCK names, which is 1Password, and that shows a dialog.
unset SSH_AUTH_SOCK
exec ssh-keygen "$@"
