# Managed by mise dotfiles. Edit ~/.config/mise/dotfiles/.ssh/config.
#
# Git to GitHub uses this machine's own key and never prompts. Everything else
# uses 1Password: the local agent at the machine you sit at, or the forwarded agent
# from it over SSH, so each Touch ID prompt appears where you are.
#
# Host entries (hostnames, users, `ForwardAgent yes`) are private and live in
# ~/.ssh/config.d/, outside the repo. Only forward the agent to hosts you
# trust: anything running as your user there can ask for signatures.
#
# OpenSSH keeps the first value it sees for each option, so the includes come
# first and the agent rules below are fallbacks.

Include ~/.orbstack/ssh/config
Include ~/.ssh/1Password/config
Include ~/.ssh/config.d/*

# GitHub: this machine's own key file, written by `mise run git:key`. Pushes
# never prompt and never touch 1Password.
Include ~/.ssh/git.conf

# Never fall back to 1Password for GitHub. Before `git:key` has run, SSH
# pushes fail instead of using your 1Password key (HTTPS still works via gh).
Host github.com
  IdentityAgent none
  IdentityFile none
  IdentitiesOnly yes

# At the machine itself: the 1Password agent, if this machine runs 1Password.
# Covers processes that never read the shell config, like GUI apps running git.
Match host * exec "~/.ssh/agent-check local"
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# Inside an SSH session: the forwarded agent, through the stable link that
# ~/.ssh/rc points at the newest connection. Long-running processes (tmux,
# herdr, agents) keep working after you reconnect.
Match host * exec "~/.ssh/agent-check forwarded"
  IdentityAgent ~/.ssh/agent.sock
