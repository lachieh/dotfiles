#!/bin/sh
# Conditions for the agent rules in ~/.ssh/config, kept here because older
# OpenSSH (e.g. Ubuntu 24.04's) rejects nested quotes in `Match exec`.
#   local      not inside an SSH session, and 1Password's agent is running
#   forwarded  inside an SSH session, with a forwarded agent linked by ~/.ssh/rc
case "${1:-}" in
  local)
    [ -z "${SSH_CONNECTION:-}" ] &&
      [ -S "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" ]
    ;;
  forwarded)
    [ -n "${SSH_CONNECTION:-}" ] && [ -S "$HOME/.ssh/agent.sock" ]
    ;;
  *) exit 2 ;;
esac
